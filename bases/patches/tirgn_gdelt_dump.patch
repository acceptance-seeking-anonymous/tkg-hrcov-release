--- /dev/null
+++ b/add_score_dump.py
@@ -0,0 +1,62 @@
+#!/usr/bin/env python3
+"""
+Insert a DUMP_SCORES-gated, try/except-wrapped per-query score dump into the
+repo's src/main.py test() object-prediction path. Idempotent. ast-parse-checks
+the result and REFUSES to write a syntactically broken file (so a bad patch can
+never break the eval — the run falls back to the unpatched, validated main.py).
+
+Anchors (stable substrings in test()):
+  init   : after 'model.eval()'
+  record : after the 'model.predict(' assignment line
+  flush  : before 'mrr_raw, hit_result_raw = utils.stat_ranks'
+"""
+import ast, sys, pathlib
+
+MAIN = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "src/main.py")
+src = MAIN.read_text()
+
+if "score_dump" in src:
+    print("[add_score_dump] already patched; skipping")
+    sys.exit(0)
+
+def block(indent, call):
+    p = " " * indent
+    return (
+        f"{p}try:\n"
+        f"{p}    import os as _os\n"
+        f'{p}    if _os.environ.get("DUMP_SCORES") == "1":\n'
+        f"{p}        import score_dump as _sd; {call}\n"
+        f"{p}except Exception as _e:\n"
+        f'{p}    print("[score_dump] skipped:", _e)\n'
+    )
+
+# --- init: after the first 'model.eval()' inside test() ---
+anchor_init = "    model.eval()\n"
+init_call = '_sd.init(_os.environ.get("DUMP_PATH", "/workspace/tirgn_scores.npz"))'
+assert anchor_init in src, "init anchor not found"
+src = src.replace(anchor_init, anchor_init + block(4, init_call), 1)
+
+# --- record: after the model.predict assignment (8-space indent, in loop) ---
+# match the line by its distinctive LHS+RHS
+import re
+m = re.search(r"^([ \t]*)test_triples, final_score, final_r_score = model\.predict\(.*\)\n",
+              src, re.M)
+assert m, "predict anchor not found"
+indent = len(m.group(1))
+rec_line = m.group(0)
+src = src.replace(rec_line, rec_line + block(indent, "_sd.record(test_triples, final_score)"), 1)
+
+# --- flush: before stat_ranks aggregation (4-space indent) ---
+anchor_flush = '    mrr_raw, hit_result_raw = utils.stat_ranks(ranks_raw, "raw_ent")\n'
+assert anchor_flush in src, "flush anchor not found"
+src = src.replace(anchor_flush, block(4, "_sd.flush()") + anchor_flush, 1)
+
+# --- validate ---
+try:
+    ast.parse(src)
+except SyntaxError as e:
+    print("[add_score_dump] REFUSING to write: patched file has SyntaxError:", e)
+    sys.exit(2)
+
+MAIN.write_text(src)
+print("[add_score_dump] patched + ast-verified:", MAIN)
