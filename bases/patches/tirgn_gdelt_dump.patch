+# field into a message) and sum (reduce messages into a dst node field).
+class _MsgFn:
+    """fn.copy_u(u, out): message = src node[u] -> edge msg field `out`."""
+    def __init__(self, u, out):
+        self.u = u
+        self.out = out
+        self.kind = "copy_u"
+
+
+class _ReduceFn:
+    """fn.sum(msg, out): sum edge msg field `msg` into dst node field `out`."""
+    def __init__(self, msg, out):
+        self.msg = msg
+        self.out = out
+        self.kind = "sum"
+
+
+def _copy_u(u, out):
+    return _MsgFn(u, out)
+
+
+def _sum(msg, out):
+    return _ReduceFn(msg, out)
+
+
+# ------------------------------------------------------------------- edge view
+class _EdgeBatch:
+    """Passed to a user message-func / apply_edges-func. Exposes .src, .dst
+    (dst/src node-field dicts gathered per edge) and .data (edge-field dict)."""
+    def __init__(self, src_data, dst_data, edata):
+        self.src = src_data
+        self.dst = dst_data
+        self.data = edata
+
+
+# ------------------------------------------------------------------- the graph
+class Graph:
+    """Minimal directed multigraph with node/edge feature dicts and a
+    scatter-add update_all. Edges are stored as parallel src/dst LongTensors."""
+
+    def __init__(self, data=None):
+        self._num_nodes = 0
+        self.src = torch.empty(0, dtype=torch.long)
+        self.dst = torch.empty(0, dtype=torch.long)
+        self.ndata = {}
+        self.edata = {}
+        self.device = torch.device("cpu")
+        if data is not None:
+            u, v = data
+            u = torch.as_tensor(u, dtype=torch.long)
+            v = torch.as_tensor(v, dtype=torch.long)
+            self.src = u
+            self.dst = v
+            if u.numel():
+                self._num_nodes = int(max(u.max().item(), v.max().item())) + 1
+
+    # ---- construction ----
+    def add_nodes(self, n):
+        self._num_nodes += int(n)
+
+    def add_edges(self, u, v):
+        u = torch.as_tensor(u, dtype=torch.long, device=self.device)
+        v = torch.as_tensor(v, dtype=torch.long, device=self.device)
+        self.src = torch.cat([self.src.to(self.device), u])
+        self.dst = torch.cat([self.dst.to(self.device), v])
+        need = int(max(u.max().item(), v.max().item())) + 1 if u.numel() else 0
+        self._num_nodes = max(self._num_nodes, need)
+
+    # ---- sizes / degrees ----
+    def num_nodes(self):
+        return self._num_nodes
+
+    def number_of_nodes(self):
+        return self._num_nodes
+
+    def in_degrees(self, nodes=None):
+        deg = torch.zeros(self._num_nodes, dtype=torch.long, device=self.device)
+        if self.dst.numel():
+            deg.scatter_add_(0, self.dst,
+                             torch.ones_like(self.dst, dtype=torch.long))
+        if nodes is None:
+            return deg
+        idx = torch.as_tensor(list(nodes), dtype=torch.long, device=self.device) \
+            if not torch.is_tensor(nodes) else nodes.to(self.device)
+        return deg[idx]
+
+    # ---- device ----
+    def to(self, dev):
+        if dev is None or (isinstance(dev, int) and dev < 0):
+            return self
+        self.device = torch.device(dev) if not isinstance(dev, torch.device) else dev
+        self.src = self.src.to(self.device)
+        self.dst = self.dst.to(self.device)
+        self.ndata = {k: (v.to(self.device) if torch.is_tensor(v) else v)
+                      for k, v in self.ndata.items()}
+        self.edata = {k: (v.to(self.device) if torch.is_tensor(v) else v)
+                      for k, v in self.edata.items()}
+        return self
+
+    def local_var(self):
+        # DGL's local_var returns a view whose feature writes don't leak out.
+        # TiRGN doesn't rely on the isolation semantics for correctness of the
+        # forward pass (it pops 'h' at the end), so returning self is safe here.
+        return self
+
+    # ---- edge ops ----
+    def apply_edges(self, func):
+        eb = _EdgeBatch(self._gather(self.src), self._gather(self.dst), self.edata)
+        out = func(eb)
+        for k, val in out.items():
+            self.edata[k] = val
+
+    def _gather(self, idx):
+        """Return a dict mapping each node-field name to per-edge gathered rows
+        for the given endpoint index tensor."""
+        g = {}
+        for k, v in self.ndata.items():
+            if torch.is_tensor(v):
+                g[k] = v[idx]
+        return g
+
+    def update_all(self, message_func, reduce_func, apply_func=None):
+        """Scatter-add message passing. Supports the two patterns TiRGN uses:
+        a user callable message_func returning {'msg': tensor}, or the builtin
+        fn.copy_u; reduction is always fn.sum into a dst node field."""
+        # 1) build per-edge messages
+        if callable(message_func) and not isinstance(message_func, _MsgFn):
+            eb = _EdgeBatch(self._gather(self.src), self._gather(self.dst), self.edata)
+            md = message_func(eb)
+            msg = md[reduce_func.msg]
+        elif isinstance(message_func, _MsgFn):
+            msg = self.ndata[message_func.u][self.src]
+        else:
+            raise TypeError("unsupported message_func")
+
+        # 2) sum into destination nodes
+        out_field = reduce_func.out
+        feat = msg.shape[1:] if msg.dim() > 1 else ()
+        agg = torch.zeros((self._num_nodes, *feat), dtype=msg.dtype, device=msg.device)
+        index = self.dst
+        idx_exp = index.view(-1, *([1] * (msg.dim() - 1))).expand_as(msg)
+        agg.scatter_add_(0, idx_exp, msg)
+        self.ndata[out_field] = agg
+
+        # 3) apply (norm multiply etc.)
+        if apply_func is not None:
+            class _Nodes:
+                def __init__(s, data): s.data = data
+            res = apply_func(_Nodes(self.ndata))
+            for k, val in res.items():
+                self.ndata[k] = val
+
+
+def graph(data):
+    return Graph(data)
+
+
+def DGLGraph():
+    return Graph()
+
+
+def _install():
+    """Register fake dgl / dgl.function / dgl.nn modules into sys.modules."""
+    if isinstance(sys.modules.get("dgl"), types.ModuleType) and \
+       getattr(sys.modules.get("dgl"), "_IS_TORCH_SHIM", False):
+        return  # idempotent
+
+    dgl_mod = types.ModuleType("dgl")
+    dgl_mod._IS_TORCH_SHIM = True
+    dgl_mod.graph = graph
+    dgl_mod.DGLGraph = DGLGraph
+    dgl_mod.__version__ = "torch-shim-0.1"
+
+    fn_mod = types.ModuleType("dgl.function")
+    fn_mod.copy_u = _copy_u
+    fn_mod.copy_src = _copy_u  # old alias
+    fn_mod.sum = _sum
+    dgl_mod.function = fn_mod
+
+    # dgl.nn is imported by some repos but TiRGN's convgcn path doesn't use it;
+    # provide an empty module so `import dgl.nn` won't crash if hit.
+    nn_mod = types.ModuleType("dgl.nn")
+
+    # dgl.data.utils: knowledge_graph.py imports download/extract_archive/etc.
+    # compat_patch already guards _get_dgl_url; provide inert stubs.
+    data_mod = types.ModuleType("dgl.data")
+    data_utils = types.ModuleType("dgl.data.utils")
+    for name in ("download", "extract_archive", "get_download_dir", "_get_dgl_url"):
+        setattr(data_utils, name, (lambda *a, **k: None))
+    data_mod.utils = data_utils
+
+    sys.modules["dgl"] = dgl_mod
+    sys.modules["dgl.function"] = fn_mod
+    sys.modules["dgl.nn"] = nn_mod
+    sys.modules["dgl.data"] = data_mod
+    sys.modules["dgl.data.utils"] = data_utils
+
+
+_install()
