--- /dev/null
+++ b/add_split_dump.py
@@ -0,0 +1,45 @@
+#!/usr/bin/env python3
+"""
+Add a DUMP_SPLIT-gated branch to TiRGN main.py that scores TRAIN or VALID queries.
+
+VALID: test(model, train_list, valid_list, ...valid_times, history_val_time_nogt, 'valid')
+       -- clean, leakage-free (TiRGN held valid out); history_list non-empty.
+TRAIN: test(model, train_list[:1], train_list[1:], ...train_times[1:], train_times[0], 'train')
+       -- seed history with the first train snapshot so the loop's sliding-window
+          pop(0)/append never underflows; the first snapshot (~1 ts) goes unscored.
+          Train scores are memorization-inflated by design (plan 4.4).
+
+Idempotent, ast-verified.
+"""
+import ast, sys, pathlib
+MAIN = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "src/main.py")
+src = MAIN.read_text()
+if "DUMP_SPLIT" in src:
+    print("[add_split_dump] already patched; skipping"); sys.exit(0)
+anchor = "    if args.test and os.path.exists(model_state_file):\n"
+assert anchor in src, "test-branch anchor not found"
+branch = (
+    "    import os as _os2\n"
+    "    _dsplit = _os2.environ.get('DUMP_SPLIT')\n"
+    "    if _dsplit in ('train', 'valid') and os.path.exists(model_state_file):\n"
+    "        checkpoint = torch.load(model_state_file, map_location=torch.device(args.gpu) if use_cuda else 'cpu')\n"
+    "        model.load_state_dict(checkpoint['state_dict'])\n"
+    "        if _dsplit == 'valid':\n"
+    "            _ = test(model, train_list, valid_list, num_rels, num_nodes, use_cuda,\n"
+    "                     all_ans_list_valid, all_ans_list_r_valid, model_state_file,\n"
+    "                     static_graph, valid_times, history_val_time_nogt, 'valid')\n"
+    "        else:\n"
+    "            _allA = utils.load_all_answers_for_time_filter(data.train, num_rels, num_nodes, False)\n"
+    "            _allAr = utils.load_all_answers_for_time_filter(data.train, num_rels, num_nodes, True)\n"
+    "            _ = test(model, train_list[:1], train_list[1:], num_rels, num_nodes, use_cuda,\n"
+    "                     _allA[1:], _allAr[1:], model_state_file,\n"
+    "                     static_graph, train_times[1:], train_times[0], 'train')\n"
+    "        import sys as _sys2; _sys2.exit(0)\n"
+)
+src = src.replace(anchor, branch + anchor, 1)
+try:
+    ast.parse(src)
+except SyntaxError as e:
+    print("[add_split_dump] REFUSING to write: SyntaxError:", e); sys.exit(2)
+MAIN.write_text(src)
+print("[add_split_dump] patched + ast-verified:", MAIN)
