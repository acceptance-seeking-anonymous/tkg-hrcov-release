diff -ruN a/src/score_dump.py b/src/score_dump.py
--- /dev/null
+++ b/src/score_dump.py
@@ -0,0 +1,69 @@
+"""
+Per-query TiRGN score dump — the feed for the AbC candidate reranker.
+
+Called from INSIDE the repo's test() object-prediction path, so the scores
+dumped here are provably the same ones that produce the validated MRR (if the
+printed filtered-MRR matches the anchor, the dump is correct by construction).
+
+Per object-prediction query we record:
+  s, r, o                : the triple (o = gold object)
+  gold_score             : final_score[i, o]      (TiRGN log-prob of the gold)
+  gold_rank_raw          : 1 + (#entities scored strictly higher than gold)
+  topk_ids   [K]         : TiRGN's top-K entity ids   (K=200)
+  topk_scores[K]         : their log-prob scores
+
+gold_score + gold_rank_raw are kept for EVERY query regardless of K, so a cold
+gold ranked far below top-K still has its exact rank on record. Stratified
+cold/mid/head MRR is computed offline from (gold_rank_raw + object frequency).
+The AbC reranker's 4 backbone features (tirgn_logprob, tirgn_inv_rank,
+tirgn_top50, tirgn_only_prov) are all derivable from topk + gold arrays.
+
+All state module-level; init()/record()/flush() are each try/except-guarded at
+the call site so a dump failure can never break the eval.
+"""
+import numpy as np
+import torch
+
+K = 200
+_buf = None
+_out_path = None
+
+
+def init(out_path):
+    global _buf, _out_path
+    _out_path = out_path
+    _buf = {"sro": [], "gold_score": [], "gold_rank_raw": [],
+            "topk_ids": [], "topk_scores": []}
+    print("[score_dump] init ->", out_path, "(K=%d)" % K)
+
+
+def record(test_triples, final_score):
+    """test_triples: [n,3] LongTensor (s,r,o). final_score: [n, num_nodes]."""
+    if _buf is None:
+        return
+    trip = test_triples.detach().cpu().numpy().astype(np.int32)
+    n = trip.shape[0]
+    o = test_triples[:, 2].long()
+    fs = final_score.detach()
+    # gold score
+    gold = fs.gather(1, o.view(-1, 1)).view(-1)
+    # raw rank = 1 + count of entities strictly greater than gold
+    greater = (fs > gold.view(-1, 1)).sum(dim=1)
+    rank = (greater + 1).cpu().numpy().astype(np.int32)
+    k = min(K, fs.shape[1])
+    tks, tki = torch.topk(fs, k, dim=1)
+    _buf["sro"].append(trip)
+    _buf["gold_score"].append(gold.cpu().numpy().astype(np.float32))
+    _buf["gold_rank_raw"].append(rank)
+    _buf["topk_ids"].append(tki.cpu().numpy().astype(np.int32))
+    _buf["topk_scores"].append(tks.cpu().numpy().astype(np.float32))
+
+
+def flush():
+    if _buf is None or not _buf["sro"]:
+        print("[score_dump] nothing to flush")
+        return
+    out = {kk: np.concatenate(vv, axis=0) for kk, vv in _buf.items()}
+    np.savez_compressed(_out_path, **out)
+    print("[score_dump] wrote %s : %d queries, topk=%s" %
+          (_out_path, out["sro"].shape[0], out["topk_ids"].shape))
