+++ b/src/get_history_fast.py
@@ -0,0 +1,72 @@
+"""
+Vectorized drop-in replacement for TiRGN get_history.py.
+
+Byte-identical output to the stock loop (same tail_history_{t}.npz /
+rel_history_{t}.npz csr_matrices, same shapes), but avoids the O(T*N)
+pure-Python re-scan: facts are sorted by time once and the cumulative
+"all facts with time < tim" set is grown incrementally by appending each
+prior timestamp's facts. Dedup + inverse-relation are vectorized in numpy.
+
+Stock semantics reproduced exactly:
+  - cumulative = all (h,r,t) with time strictly < tim  (union train+valid+test)
+  - forward + inverse (r += raw_num_r) rows, then unique over (h,r',t)
+  - tail_seq: csr (num_e*num_r2, num_e) with row = h*num_r2 + r', col = t
+  - rel_seq : csr (num_e*num_e, num_r2) with row = h*num_e + t, col = r'
+  - first timestamp writes empty matrices
+  where num_r2 = 2*raw_num_r
+"""
+import os, argparse, numpy as np, scipy.sparse as sp
+from tqdm import tqdm
+
+ap = argparse.ArgumentParser()
+ap.add_argument("--dataset", required=True)
+args = ap.parse_args()
+
+DD = f"../data/{args.dataset}"
+def load(fn):
+    out=[]
+    with open(os.path.join(DD,fn)) as fr:
+        for line in fr:
+            s=line.split()
+            if len(s)>=4:
+                out.append((int(s[0]),int(s[1]),int(s[2]),int(s[3])))  # h,r,t,ts
+    return out
+def totals():
+    with open(os.path.join(DD,"stat.txt")) as fr:
+        a=fr.readline().split(); return int(a[0]),int(a[1])
+
+all_q = load("train.txt")+load("valid.txt")+load("test.txt")
+num_e, raw_num_r = totals()
+num_r2 = raw_num_r*2
+
+arr = np.asarray(all_q, dtype=np.int64)          # (N,4): h,r,t,ts
+times = np.unique(arr[:,3]); times.sort()
+order = np.argsort(arr[:,3], kind="stable")
+arr = arr[order]
+ts_sorted = arr[:,3]
+# for each timestamp, the slice of facts with ts < tim = arr[:lo] where lo=searchsorted(ts,tim,'left')
+save_dir = f"{DD}/history/"
+os.makedirs(save_dir, exist_ok=True)
+
+for tim in tqdm(times):
+    lo = np.searchsorted(ts_sorted, tim, side="left")   # facts strictly before tim
+    if tim != times[0] and lo > 0:
+        block = arr[:lo, :3]                      # (M,3) h,r,t forward
+        inv = block[:, [2,1,0]].copy()            # t, r, h
+        inv[:,1] += raw_num_r                     # inverse relation id
+        both = np.concatenate([block, inv], axis=0)   # (2M,3): h,r',t
+        # unique rows (sorted=False in stock; order irrelevant for csr build)
+        both = np.unique(both, axis=0)
+        h,rp,t = both[:,0], both[:,1], both[:,2]
+        # entity (tail) history: row=h*num_r2+r', col=t
+        row = h*num_r2 + rp; col = t
+        tail_seq = sp.csr_matrix((np.ones(len(row)), (row,col)), shape=(num_e*num_r2, num_e))
+        # relation history: row=h*num_e+t, col=r'
+        rrow = h*num_e + t; rcol = rp
+        rel_seq = sp.csr_matrix((np.ones(len(rrow)), (rrow,rcol)), shape=(num_e*num_e, num_r2))
+    else:
+        tail_seq = sp.csr_matrix(([],([],[])), shape=(num_e*num_r2, num_e))
+        rel_seq  = sp.csr_matrix(([],([],[])), shape=(num_e*num_e, num_r2))
+    sp.save_npz(f"{save_dir}tail_history_{tim}.npz", tail_seq)
+    sp.save_npz(f"{save_dir}rel_history_{tim}.npz", rel_seq)
+print(f"[get_history_fast] done: {len(times)} timestamps, num_e={num_e} num_r2={num_r2}")
