+"""Full-score TiRGN dump hook (retriever track). Drop-in replacement for score_dump.py:
+same init/record/flush API, but writes the FULL [n, N_ent] float32 log-score matrix to
+FULL_OUT + '_scores_f32.bin' (row-major, appended per snapshot) plus a meta npz with
+sro (s,r',o), gold_score, gold_rank_raw (strict >), logsumexp per row."""
+import os, json
+import numpy as np
+import torch
+_st = None
+
+def init(out_path):
+    global _st
+    base = os.environ["FULL_OUT"]
+    os.makedirs(os.path.dirname(base), exist_ok=True)
+    _st = dict(base=base, f=open(base + "_scores_f32.bin", "wb"), sro=[], gs=[], rk=[], lse=[], n=0, ncol=None)
+    print("[full_dump] init ->", base, flush=True)
+
+def record(test_triples, final_score):
+    if _st is None:
+        return
+    fs = final_score.detach().float()
+    o = test_triples[:, 2].long()
+    gold = fs.gather(1, o.view(-1, 1)).view(-1)
+    rank = (fs > gold.view(-1, 1)).sum(dim=1) + 1
+    lse = torch.logsumexp(fs, dim=1)
+    a = fs.cpu().numpy().astype(np.float32)
+    _st["f"].write(np.ascontiguousarray(a).tobytes())
+    _st["ncol"] = int(a.shape[1]); _st["n"] += int(a.shape[0])
+    _st["sro"].append(test_triples.detach().cpu().numpy().astype(np.int32)[:, :3])
+    _st["gs"].append(gold.cpu().numpy().astype(np.float32))
+    _st["rk"].append(rank.cpu().numpy().astype(np.int32))
+    _st["lse"].append(lse.cpu().numpy().astype(np.float32))
+
+def flush():
+    if _st is None or _st["n"] == 0:
+        print("[full_dump] nothing to flush"); return
+    _st["f"].close()
+    np.savez(_st["base"] + "_meta.npz", sro=np.concatenate(_st["sro"]), gold_score=np.concatenate(_st["gs"]),
+             gold_rank_raw=np.concatenate(_st["rk"]), lse=np.concatenate(_st["lse"]),
+             n_rows=np.int64(_st["n"]), n_ent=np.int64(_st["ncol"]))
+    print("[full_dump] wrote %d rows x %d cols" % (_st["n"], _st["ncol"]), flush=True)
