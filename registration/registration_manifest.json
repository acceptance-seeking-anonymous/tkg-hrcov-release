{
 "title": "Registration files of Manuscript A: recorded hashes, conventions and time stamps (code-release copy)",
 "hash_convention": {
  "indent1_sorted": "sha256(json.dumps(body, indent=1, sort_keys=True, default=str)), body = file content without the 'sha256' field (registered_utc kept)",
  "oneline_sorted": "sha256(json.dumps(body, sort_keys=True, default=str)), same body, default separators, one line",
  "note": "the hash is computed before writing; the file is written in insertion order with the 'sha256' field embedded, so sha256(file bytes) differs from the recorded hash",
  "file_sha256": "v7.9 outcome documents without a registration-time hash (freeze manifest, uninspected check, verdict): content_hash = sha256 of the original file bytes, recorded at release time (content_hash_kind = file_sha256); recorded_sha256 stays null"
 },
 "redaction": "host names, IP addresses and local paths replaced by <HOST>, <SCRATCH>, <HOME>; files with redacted=true cannot reproduce their recorded hash without the unredacted original (run the checker with --originals DIR); per-file changed fields, placeholders and reasons (no original values) in registration/redaction_map.json; structure_sha256 fingerprints the JSON structure (pointers and value types), which redaction does not change; release v4 (redaction_rules = v2, the v7.9 documents): addresses and bare host numbers are first replaced by the neutral server labels serverA/serverB/serverC (by last octet), so that host-keyed objects keep distinct keys, then the path rules apply; key renames are listed per file in redaction_map.json (renamed_keys) and structure_sha256 fingerprints the bundled copy",
 "store_saved_utc": "time at which the file was saved to the project's internal file store (independent of the registered_utc field written in the file; not an external time-stamping authority)",
 "build_check_against_original": "result of recomputing the recorded hash from the unredacted original at bundle build time",
