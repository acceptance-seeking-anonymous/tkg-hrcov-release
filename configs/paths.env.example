# configs/paths.env.example -- copy to configs/paths.env and edit; read by configs/env.sh
# Working tree of all runs: converted datasets, base checkpoints and score dumps, candidate lists, features, re-ranker outputs
# and official-evaluator outputs (the scripts create WORK_DIR/tracks/<pipeline>/...).  The full study needs several TB;
# the smoke test needs about 6 GB.
export WORK_DIR=/data/tkg_work
# Inputs that predate this study: ICEWS18 and GDELT in the RE-GCN release format (EXT_DIR/logcl_redun/data/ICEWS18,
# EXT_DIR/gdelt_armAD/data/GDELT) and their TiRGN score dumps (see data/README.md)
export EXT_DIR=$WORK_DIR/ext
# Outputs of earlier runs that a few aggregation scripts read (RESULTS_DIR/runs/<run>/...)
export RESULTS_DIR=$WORK_DIR/results_runs
# Third-party code (bases/fetch_upstream.sh) and staged inputs (TGB source archive)
export BASES_DIR=$WORK_DIR/bases
export STAGE_DIR=$WORK_DIR/stage_inputs
# GPU index used by every script (the original runs pinned one card per process)
export GPU=0
