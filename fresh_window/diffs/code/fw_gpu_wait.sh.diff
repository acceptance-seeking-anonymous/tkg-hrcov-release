--- a/phase2_forward_holdout/code/fh_gpu_wait.sh
+++ b/code/fw_gpu_wait.sh
@@ -1,22 +1,15 @@
-# phase2_forward_holdout / fh_gpu_wait.sh -- sourced by the stage scripts.  Sets FH_GPU (physical card index) once a card is
-# allowed under the lead's rule (2026-10-14):
-#   GPU 1 (shared by other tracks): only if > 35 GB free at dispatch; this track's process is capped at 30 GB.
-#   GPU 0: only once nvidia-smi shows NO G8 process (cmdline containing g8_ / cogntke) on it (and > 35 GB free).
-# Checks every FH_WAIT_S seconds (default 1800 = 30 min); every check is logged to $L/gpu_wait.log.
+# phase2_fresh_window / fw_gpu_wait.sh -- sourced by the stage scripts. v79 rule (lead 2026-10-16): serverA GPU 0 ONLY.
+# Sets FH_GPU=0 once GPU 0 has > 35 GB free (this track's process is capped at FH_GPU_CAP_GB = 30 GB). Every check logs
+# GPU 0 free memory, utilisation and all compute processes on it to $L/gpu_wait.log. GPU 1 is never selected.
 fh_gpu_wait() {
   FH_GPU=""
   while [ -z "$FH_GPU" ]; do
-    F1=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i 1 | tr -d ' ')
     F0=$(nvidia-smi --query-gpu=memory.free --format=csv,noheader,nounits -i 0 | tr -d ' ')
-    U0=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i 0 | tr -d ' ')
-    NG8=0
-    for p in $(nvidia-smi --query-compute-apps=gpu_uuid,pid --format=csv,noheader | tr -d ' ' | grep "^$U0," | cut -d, -f2); do
-      ps -o args= -p "$p" 2>/dev/null | grep -qiE 'g8_|cogntke' && NG8=$((NG8 + 1))
-    done
-    echo "[gpu-wait] $(date -u +%FT%TZ) gpu0_free=${F0}MiB g8_procs_on_gpu0=${NG8} gpu1_free=${F1}MiB" >> "$L/gpu_wait.log"
-    if [ "${F1:-0}" -gt 35840 ]; then FH_GPU=1
-    elif [ "$NG8" -eq 0 ] && [ "${F0:-0}" -gt 35840 ]; then FH_GPU=0
-    else sleep "${FH_WAIT_S:-1800}"; fi
+    U0=$(nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits -i 0 | tr -d ' ')
+    ID0=$(nvidia-smi --query-gpu=uuid --format=csv,noheader -i 0 | tr -d ' ')
+    PR=$(nvidia-smi --query-compute-apps=gpu_uuid,pid,used_memory --format=csv,noheader | tr -d ' ' | grep "^$ID0," | cut -d, -f2,3 | tr '\n' ' ')
+    echo "[gpu-wait] $(date -u +%FT%TZ) gpu0_free=${F0}MiB gpu0_util=${U0}% gpu0_procs=[${PR}] load=$(cut -d' ' -f1-3 /proc/loadavg)" >> "$L/gpu_wait.log"
+    if [ "${F0:-0}" -gt 35840 ]; then FH_GPU=0; else sleep "${FH_WAIT_S:-600}"; fi
   done
   echo "[gpu-wait] $(date -u +%FT%TZ) -> physical GPU $FH_GPU (cap ${FH_GPU_CAP_GB:-30} GB)" >> "$L/gpu_wait.log"
 }
