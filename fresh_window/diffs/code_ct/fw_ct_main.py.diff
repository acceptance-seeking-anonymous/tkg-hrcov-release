+class HarnessDataset:
+    def __init__(self, name, root="datasets", preprocess=True):
+        assert name == NAME, name
+        st = open(f"{DD}/stat.txt").read().split(); N, R = int(st[0]), int(st[1])
+        qs = {sp: np.loadtxt(f"{DD}/{sp}.txt", dtype=np.int64, usecols=(0, 1, 2, 3)).reshape(-1, 4) for sp in ("train", "valid", "test")}
+        fwd = np.concatenate([qs[sp][np.argsort(qs[sp][:, 3], kind="stable")] for sp in ("train", "valid", "test")])
+        spl = np.concatenate([np.full(len(qs[sp]), k, np.int8) for k, sp in enumerate(("train", "valid", "test"))])
+        assert (np.diff(fwd[:, 3]) >= 0).all(), "facts not in time order"
+        id2day = {}
+        for ln in open(f"{DD}/timestamp2id.txt"):
+            k, v = ln.split(); id2day[int(v)] = k
+        unix = np.array([calendar.timegm(time.strptime(id2day[t], "%Y%m%d")) for t in range(len(id2day))], np.int64)
+        ts = unix[fwd[:, 3]]
+        nrel_fwd = int(np.unique(fwd[:, 1]).shape[0]); assert nrel_fwd == R, (nrel_fwd, R)   # add_inverse_quadruples offset
+        self.name = name; self.root = ROOT
+        src = np.concatenate([fwd[:, 0], fwd[:, 2]]).astype(int); dst = np.concatenate([fwd[:, 2], fwd[:, 0]]).astype(int)
+        et = np.concatenate([fwd[:, 1], fwd[:, 1] + nrel_fwd]).astype(int); tt = np.concatenate([ts, ts]).astype(int)
+        sp2 = np.concatenate([spl, spl])
+        self.full_data = dict(sources=src, destinations=dst, timestamps=tt, edge_type=et,
+                              edge_idxs=np.arange(len(src)), w=np.ones(len(src)), edge_label=np.ones(len(src)))
+        self.edge_type = et
+        self.train_mask = sp2 == 0; self.val_mask = sp2 == 1; self.test_mask = sp2 == 2
+        self.num_rels = int(np.unique(et).shape[0]); assert self.num_rels == 2 * R
+        self.num_nodes = int(np.unique(np.concatenate([src, dst])).shape[0]); assert self.num_nodes == N
+        # CountTRuCoLa's own ts ids (rule_dataset.reformat_ts) must equal the harness ts ids: checked after RuleDataset init
